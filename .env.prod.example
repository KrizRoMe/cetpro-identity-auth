# Copiar a .env.prod y completar con valores reales. Nunca commitear .env.prod.

# Dominios publicos (detras del reverse proxy con HTTPS)
KEYCLOAK_HOSTNAME=auth.tudominio.com
API_HOSTNAME=api.tudominio.com

# Postgres (base de datos de Keycloak)
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=cambiar-por-un-password-fuerte

# Keycloak admin (consola /admin)
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=cambiar-por-un-password-fuerte

# Realm y client que usa el orquestador para el authorization code flow
KEYCLOAK_REALM=ecosystem
KEYCLOAK_CLIENT_ID=moodle-client
KEYCLOAK_CLIENT_SECRET=cambiar-por-el-secret-real-del-client
